# ============================================================
# App
# ============================================================
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
API_URL=http://localhost:3000
WEB_PORT=3001
WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ============================================================
# Database (PostgreSQL)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iron_ledger
POSTGRES_USER=iron_ledger
POSTGRES_PASSWORD=iron_ledger
# Se o app consome uma URL única em vez de campos separados:
DATABASE_URL=postgresql://iron_ledger:iron_ledger@localhost:5432/iron_ledger

# ============================================================
# Cache (Redis)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ============================================================
# Message Broker (RabbitMQ)
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=iron_ledger
RABBITMQ_PASSWORD=iron_ledger
RABBITMQ_URL=amqp://iron_ledger:iron_ledger@localhost:5672

# ============================================================
# Event Streaming (Kafka)
# ============================================================
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=iron-ledger
# Se usar Kafka + Schema Registry, provavelmente falta:
# KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
# KAFKA_CONSUMER_GROUP_ID=iron-ledger-consumers

# ============================================================
# Workflow Orchestration (Temporal)
# ============================================================
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=iron-ledger-tasks

# ============================================================
# Observability (OpenTelemetry + Jaeger)
# ============================================================
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_SERVICE_NAME=iron-ledger-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_UI_PORT=16686

# ============================================================
# Analytics
# ============================================================
ANALYTICS_PORT=8000
ANALYTICS_URL=http://localhost:8000

# ============================================================
# Auth
# ============================================================
JWT_SECRET=local-development-secret-change-before-production
JWT_EXPIRES_IN=1h
# Provavelmente falta refresh token, já que access token é curto (1h):
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# Seed / Bootstrap
# ============================================================
SEED_ADMIN_EMAIL=admin@ironledger.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ============================================================
# Docker Compose Profiles
# ============================================================
# Comma-separated: platform,analytics,observability
# COMPOSE_PROFILES=platform,analytics,observability

# ============================================================
# ⚠️ Segurança
# ============================================================
# Todas as credenciais acima são apenas para desenvolvimento local.
# Substitua TODOS os valores em ambientes compartilhados ou produção.
