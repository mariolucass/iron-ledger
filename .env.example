# Iron Ledger — configuração principal de desenvolvimento local.
# Copie para .env na raiz: cp .env.example .env
# Os comandos pnpm dev:*, db:* e a API/seed usam esta base.
# Prioridade: variáveis do terminal > .env opcional do app > .env da raiz.
# Valores são literais: não use ${OUTRA_VARIAVEL} para montar URLs.
# Credenciais abaixo são apenas para desenvolvimento local.

# Aplicação — API e logs
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
WEB_PORT=3001
# URLs locais são derivadas das portas. Descomente para outro host/proxy.
# API_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3001
# PORT é reservado ao runtime/hosting; use API_PORT e WEB_PORT neste arquivo.
# Proxies confiáveis à frente da API; o BFF do Next conta como 1. Define o IP do
# cliente (X-Forwarded-For) usado pelo rate limit de /auth. Use 0 se a API for
# acessada diretamente, sem proxy.
# TRUST_PROXY_HOPS=1
# Origens de navegador autorizadas a chamar a API direto (separadas por vírgula).
# Vazio desliga o CORS: o web usa o BFF, que chama a API pelo servidor.
# CORS_ALLOWED_ORIGINS=

# Conexões dos processos executados no host (API, Prisma e seed)
# Para PostgreSQL/RabbitMQ existentes, ajuste estas URLs.
# Use URL-encode no usuário/senha se houver caracteres especiais.
DATABASE_URL=postgresql://iron_ledger:iron_ledger@localhost:5432/iron_ledger?schema=public
RABBITMQ_URL=amqp://iron_ledger:iron_ledger@localhost:5672

# Autenticação e conta inicial — API, seed e fallback do worker
JWT_SECRET=local-development-secret-change-before-production
JWT_EXPIRES_IN=1h
SEED_ADMIN_EMAIL=admin@ironledger.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Alterar estas variáveis não altera uma conta existente; db:seed atualiza a conta
# e também repõe a massa de demonstração de estoque.

# Publicação de eventos da API
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

# Docker Compose — provisionamento e portas da infraestrutura
# Não substituem DATABASE_URL/RABBITMQ_URL nos processos do host.
# Se mudar as credenciais abaixo, ajuste também as URLs acima.
# Containers usam os hosts internos postgres/rabbitmq, definidos no Compose.
# Mudar estas credenciais não modifica usuários de volumes já inicializados.
POSTGRES_PORT=5432
POSTGRES_DB=iron_ledger
POSTGRES_USER=iron_ledger
POSTGRES_PASSWORD=iron_ledger
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=iron_ledger
RABBITMQ_PASSWORD=iron_ledger
REDIS_PORT=6379

# EVENT_BUS=memory dispensa o RabbitMQ (pnpm dev:lite já define isso).
# EVENT_BUS=rabbitmq

# Opcional: Temporal — API/worker e perfil Docker platform
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=iron-ledger-tasks
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
# Conta dedicada já provisionada na API com papel SERVICE (ou ADMIN).
# Sem estas duas variáveis, o worker usa SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD.
# WORKER_SERVICE_EMAIL=worker@ironledger.local
# WORKER_SERVICE_PASSWORD=replace-with-a-service-password

# Opcional: analytics — serviço Python e perfil Docker analytics
ANALYTICS_PORT=8000
# URL interna usada pelo servidor web e pelo painel de serviços da API.
# ANALYTICS_URL=http://localhost:8000
# Prefira um caminho absoluto; o padrão é services/analytics/data/processed/analytics.db.
# ANALYTICS_DATABASE_PATH=/absolute/path/analytics.db

# Opcional: infraestrutura Kafka/Jaeger (portas Docker; sem clientes configurados)
KAFKA_PORT=9092
# Brokers verificados pelo painel de serviços; o padrão é localhost:KAFKA_PORT.
# KAFKA_BROKERS=localhost:9092
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Perfis Docker opcionais, separados por vírgula: platform,worker,analytics,observability
# COMPOSE_PROFILES=platform,worker,analytics,observability
