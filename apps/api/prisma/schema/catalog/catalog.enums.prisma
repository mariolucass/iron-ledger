enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
  ARCHIVED

  @@schema("catalog")
}

/// Granularidade de rastreabilidade exigida pelo produto.
enum TrackingMode {
  NONE
  LOT
  SERIAL

  @@schema("catalog")
}

enum UnitOfMeasureType {
  UNIT
  WEIGHT
  VOLUME
  LENGTH
  AREA
  TIME

  @@schema("catalog")
}

enum BarcodeType {
  EAN_13
  EAN_8
  UPC_A
  GTIN_14
  CODE_128
  QR_CODE
  INTERNAL

  @@schema("catalog")
}
