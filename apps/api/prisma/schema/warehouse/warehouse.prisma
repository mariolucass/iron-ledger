// =============================================================================
// warehouse — agregado Warehouse
// =============================================================================

model Warehouse {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  name        String
  type        WarehouseType @default(DISTRIBUTION_CENTER)
  /// Endereço livre para exibição; campos estruturados abaixo.
  address     String?
  addressLine String?       @map("address_line")
  city        String?
  state       String?
  postalCode  String?       @map("postal_code")
  countryCode String        @default("BR") @map("country_code") @db.Char(2)
  latitude    Decimal?      @db.Decimal(9, 6)
  longitude   Decimal?      @db.Decimal(9, 6)
  timezone    String        @default("America/Sao_Paulo")
  /// CNPJ do estabelecimento, quando aplicável.
  taxId       String?       @map("tax_id")
  isActive    Boolean       @default(true) @map("is_active")
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  locations         WarehouseLocation[]
  userAccesses      UserWarehouseAccess[]
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  reservations      StockReservation[]
  locationStocks    LocationStock[]
  outgoingTransfers StockTransfer[]       @relation("TransferSource")
  incomingTransfers StockTransfer[]       @relation("TransferDestination")
  stockCounts       StockCount[]

  @@index([isActive, deletedAt])
  @@index([type])
  @@map("warehouses")
  @@schema("warehouse")
}
