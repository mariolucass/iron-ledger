// =============================================================================
// platform — mensageria confiável (Transactional Outbox / Inbox)
// =============================================================================

/// Evento de domínio gravado na mesma transação da mutação e publicado no
/// RabbitMQ por um relay. Elimina a janela de perda entre commit e publish.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  /// Ordem de publicação por agregado.
  sequence      BigInt       @unique @default(autoincrement())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventName     String       @map("event_name")
  eventVersion  Int          @default(1) @map("event_version")
  exchange      String       @default("iron-ledger.domain")
  routingKey    String       @map("routing_key")
  payload       Json
  headers       Json?
  correlationId String?      @map("correlation_id")
  causationId   String?      @map("causation_id")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  availableAt   DateTime     @default(now()) @map("available_at")
  lockedUntil   DateTime?    @map("locked_until")
  publishedAt   DateTime?    @map("published_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, sequence])
  @@index([correlationId])
  @@map("outbox_events")
  @@schema("platform")
}

/// Registro de mensagens consumidas: garante processamento exatamente-uma-vez
/// por consumidor.
model InboxMessage {
  id          String      @id @default(uuid()) @db.Uuid
  messageId   String      @map("message_id")
  consumer    String
  eventName   String      @map("event_name")
  status      InboxStatus @default(RECEIVED)
  attempts    Int         @default(0)
  lastError   String?     @map("last_error")
  receivedAt  DateTime    @default(now()) @map("received_at")
  processedAt DateTime?   @map("processed_at")

  @@unique([consumer, messageId])
  @@index([status, receivedAt])
  @@map("inbox_messages")
  @@schema("platform")
}

/// Idempotência de requisições HTTP (`Idempotency-Key`).
model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  key            String
  /// Rota/operação + ator (ex.: `POST /inventory/movements:<userId>`).
  scope          String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  lockedUntil    DateTime?         @map("locked_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  expiresAt      DateTime          @map("expires_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("platform")
}
