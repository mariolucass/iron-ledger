// =============================================================================
// inventory — saldos (agregado StockLevel e saldo por endereço)
// =============================================================================

/// Saldo consolidado por produto e armazém. Toda alteração passa por
/// concorrência otimista (`version`) e gera um StockMovement na mesma transação.
/// Invariantes a garantir via CHECK na migration: quantity >= 0,
/// reserved >= 0 e reserved <= quantity.
model StockLevel {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  quantity       Decimal   @default(0) @db.Decimal(18, 4)
  reserved       Decimal   @default(0) @db.Decimal(18, 4)
  /// Quantidade em trânsito (transferências expedidas ainda não recebidas).
  incoming       Decimal   @default(0) @db.Decimal(18, 4)
  version        Int       @default(0)
  lastMovementAt DateTime? @map("last_movement_at")
  lastCountedAt  DateTime? @map("last_counted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_levels")
  @@schema("inventory")
}

/// Saldo detalhado por endereço físico e lote. A soma por produto/armazém deve
/// fechar com StockLevel.quantity. Como `lotId` é opcional, use
/// `UNIQUE NULLS NOT DISTINCT` (PostgreSQL 15+) na migration.
model LocationStock {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  lotId       String?  @map("lot_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  reserved    Decimal  @default(0) @db.Decimal(18, 4)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product           @relation(fields: [productId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation @relation(fields: [locationId], references: [id])
  lot       InventoryLot?     @relation(fields: [lotId], references: [id])

  @@unique([locationId, productId, lotId])
  @@index([productId, warehouseId])
  @@index([lotId])
  @@map("location_stocks")
  @@schema("inventory")
}
