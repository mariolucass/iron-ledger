// =============================================================================
// inventory — lotes e números de série (rastreabilidade)
// =============================================================================

/// Lote (ou número de série, quando `Product.trackingMode = SERIAL`).
/// Base para FEFO/FIFO e para recall.
model InventoryLot {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  lotNumber      String    @map("lot_number")
  serialNumber   String?   @map("serial_number")
  status         LotStatus @default(AVAILABLE)
  manufacturedAt DateTime? @map("manufactured_at")
  expiresAt      DateTime? @map("expires_at")
  receivedAt     DateTime? @map("received_at")
  /// Fornecedor/origem (referência externa, sem FK).
  supplierRef    String?   @map("supplier_ref")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product         Product             @relation(fields: [productId], references: [id])
  locationStocks  LocationStock[]
  movements       StockMovement[]
  reservations    StockReservation[]
  transferItems   StockTransferItem[]
  stockCountItems StockCountItem[]

  @@unique([productId, lotNumber])
  @@unique([productId, serialNumber])
  @@index([status, expiresAt])
  @@map("inventory_lots")
  @@schema("inventory")
}
