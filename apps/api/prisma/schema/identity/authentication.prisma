// =============================================================================
// identity — autenticação: sessões, MFA, SSO, tokens e chaves de API
// =============================================================================

/// Sessão com refresh token rotativo. `familyId` agrupa as rotações para
/// revogar a família inteira quando um token antigo for reutilizado.
model UserSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash")
  status           SessionStatus @default(ACTIVE)
  userAgent        String?       @map("user_agent")
  ipAddress        String?       @map("ip_address") @db.Inet
  replacedById     String?       @unique @map("replaced_by_id") @db.Uuid
  expiresAt        DateTime      @map("expires_at")
  lastUsedAt       DateTime?     @map("last_used_at")
  revokedAt        DateTime?     @map("revoked_at")
  revokedReason    String?       @map("revoked_reason")
  createdAt        DateTime      @default(now()) @map("created_at")

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy UserSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   UserSession? @relation("SessionRotation")

  @@index([userId, status])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_sessions")
  @@schema("identity")
}

model MfaFactor {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  method          MfaMethod
  label           String?
  /// Segredo cifrado pela aplicação (envelope encryption / KMS).
  secretEncrypted String?   @map("secret_encrypted")
  /// Credencial pública WebAuthn.
  credentialId    String?   @unique @map("credential_id")
  publicKey       Bytes?    @map("public_key")
  signCount       Int       @default(0) @map("sign_count")
  verifiedAt      DateTime? @map("verified_at")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method])
  @@map("mfa_factors")
  @@schema("identity")
}

/// Vínculo com provedores externos de identidade (SSO corporativo).
model FederatedIdentity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  provider    IdentityProvider
  /// Identificador do provedor configurado (ex.: tenant do Entra ID).
  providerKey String           @default("default") @map("provider_key")
  subject     String
  email       String?
  claims      Json?
  lastLoginAt DateTime?        @map("last_login_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerKey, subject])
  @@index([userId])
  @@map("federated_identities")
  @@schema("identity")
}

/// Tokens de uso único (verificação de e-mail, redefinição de senha, convite).
model VerificationToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
  @@schema("identity")
}

/// Credencial máquina-a-máquina (integrações, worker, ERPs externos).
model ApiKey {
  id         String       @id @default(uuid()) @db.Uuid
  ownerId    String       @map("owner_id") @db.Uuid
  name       String
  /// Prefixo público exibido na UI para identificar a chave (ex.: `il_live_ab12`).
  prefix     String       @unique
  keyHash    String       @unique @map("key_hash")
  status     ApiKeyStatus @default(ACTIVE)
  allowedIps String[]     @default([]) @map("allowed_ips")
  expiresAt  DateTime?    @map("expires_at")
  lastUsedAt DateTime?    @map("last_used_at")
  revokedAt  DateTime?    @map("revoked_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  permissions ApiKeyPermission[]

  @@index([ownerId, status])
  @@map("api_keys")
  @@schema("identity")
}

/// Pivô ApiKey ↔ Permission: escopo explícito e mínimo de cada chave.
model ApiKeyPermission {
  apiKeyId     String   @map("api_key_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")

  apiKey     ApiKey     @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, permissionId])
  @@index([permissionId])
  @@map("api_key_permissions")
  @@schema("identity")
}
