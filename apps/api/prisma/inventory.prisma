enum MovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  RESERVATION
  RELEASE
  RETURN
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

model StockLevel {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid @map("product_id")
  warehouseId String   @db.Uuid @map("warehouse_id")
  quantity    Decimal  @default(0) @db.Decimal(12, 4)
  reserved    Decimal  @default(0) @db.Decimal(12, 4)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @db.Uuid @map("product_id")
  warehouseId   String       @db.Uuid @map("warehouse_id")
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 4)
  previousQty   Decimal      @map("previous_qty") @db.Decimal(12, 4)
  resultingQty  Decimal      @map("resulting_qty") @db.Decimal(12, 4)
  referenceId   String?      @map("reference_id")
  referenceType String?      @map("reference_type")
  notes         String?
  performedBy   String       @db.Uuid @map("performed_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  performer User      @relation(fields: [performedBy], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([referenceId, referenceType])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @db.Uuid @map("product_id")
  warehouseId   String            @db.Uuid @map("warehouse_id")
  transactionId String?           @unique @db.Uuid @map("transaction_id")
  quantity      Decimal           @db.Decimal(12, 4)
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime?         @map("expires_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId, warehouseId, status])
  @@index([expiresAt])
  @@map("stock_reservations")
}
