// ============================================================
// iron-ledger — Prisma Schema
// Auditoria, Controle de Estoque e Orquestração de Transações
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MovementType {
  INBOUND      // Entrada de mercadoria
  OUTBOUND     // Saída de mercadoria
  TRANSFER     // Transferência entre warehouses
  ADJUSTMENT   // Ajuste manual (inventário físico)
  RESERVATION  // Reserva de estoque
  RELEASE      // Liberação de reserva
  RETURN       // Devolução
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMMITTED
  COMPENSATING
  COMPENSATED
  FAILED
}

enum TransactionType {
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  ORDER_FULFILLMENT
  RETURN_PROCESSING
}

enum WorkflowStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ             // leituras sensíveis (ex: dados financeiros)
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  EXPORT
}

// ============================================================
// IDENTITY CONTEXT
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")  // soft delete

  userRoles      UserRole[]
  sessions       UserSession[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  transactions   Transaction[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Roles de sistema não podem ser deletadas (ADMIN, AUDITOR, etc.)
  isSystem    Boolean @default(false) @map("is_system")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String           @id @default(uuid()) @db.Uuid

  // "inventory.product", "audit.log", "transaction"
  resource String
  action   PermissionAction

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId    String   @db.Uuid @map("user_id")
  roleId    String   @db.Uuid @map("role_id")
  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @db.Uuid @map("granted_by")

  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid @map("role_id")
  permissionId String @db.Uuid @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// INVENTORY CONTEXT
// ============================================================

model Warehouse {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  address  String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  reservations   StockReservation[]

  @@map("warehouses")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  sku         String  @unique
  name        String
  description String?
  unit        String  @default("un") // un, kg, l, cx, m...
  isActive    Boolean @default(true) @map("is_active")

  // Thresholds para alertas automáticos
  minStock    Decimal  @default(0) @map("min_stock") @db.Decimal(12, 4)
  maxStock    Decimal? @map("max_stock") @db.Decimal(12, 4)

  // Campos flexíveis sem quebrar o schema (cor, dimensões, categoria...)
  metadata    Json?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  reservations     StockReservation[]
  transactionItems TransactionItem[]

  @@map("products")
}

model StockLevel {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @db.Uuid @map("product_id")
  warehouseId String  @db.Uuid @map("warehouse_id")

  // Estoque disponível (já descontando reservas)
  quantity    Decimal @default(0) @db.Decimal(12, 4)

  // Quantidade comprometida por reservas ativas
  reserved    Decimal @default(0) @db.Decimal(12, 4)

  // Optimistic locking — previne race conditions sem lock pessimista
  // O update só ocorre se version == valor atual no DB
  version     Int     @default(0)

  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid @map("product_id")
  warehouseId String       @db.Uuid @map("warehouse_id")
  type        MovementType

  quantity    Decimal @db.Decimal(12, 4)

  // Snapshot do estoque antes e depois — fundamental para auditoria
  // Permite reconstruir o histórico mesmo sem event sourcing completo
  previousQty  Decimal @map("previous_qty") @db.Decimal(12, 4)
  resultingQty Decimal @map("resulting_qty") @db.Decimal(12, 4)

  // Rastreabilidade: liga o movimento a sua origem
  referenceId   String? @map("reference_id")   // ID da transaction, pedido, etc.
  referenceType String? @map("reference_type") // "transaction" | "order" | "manual"

  notes       String?
  performedBy String  @db.Uuid @map("performed_by")

  // Append-only: nunca atualizar, nunca deletar
  createdAt   DateTime @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  performer User      @relation(fields: [performedBy], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([referenceId, referenceType])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockReservation {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @db.Uuid @map("product_id")
  warehouseId   String            @db.Uuid @map("warehouse_id")
  transactionId String?           @db.Uuid @map("transaction_id")

  quantity      Decimal           @db.Decimal(12, 4)
  status        ReservationStatus @default(ACTIVE)

  // TTL da reserva — expiradas são liberadas por job/workflow
  expiresAt     DateTime?         @map("expires_at")

  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productId], references: [id])
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([productId, warehouseId, status])
  @@index([transactionId])
  @@index([expiresAt]) // índice para o job de expiração
  @@map("stock_reservations")
}

// ============================================================
// TRANSACTION CONTEXT
// ============================================================

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  initiatedBy String            @db.Uuid @map("initiated_by")

  // Contexto livre para a saga — payload de entrada, ids externos, etc.
  metadata    Json?

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  initiator     User                 @relation(fields: [initiatedBy], references: [id])
  items         TransactionItem[]
  workflow      TransactionWorkflow?
  compensations CompensationLog[]
  reservations  StockReservation[]

  @@index([status])
  @@index([initiatedBy])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            String  @id @default(uuid()) @db.Uuid
  transactionId String  @db.Uuid @map("transaction_id")
  productId     String  @db.Uuid @map("product_id")

  quantity      Decimal @db.Decimal(12, 4)

  // Snapshot do produto no momento da transação
  // Garante rastreabilidade mesmo se o produto for alterado depois
  productSku    String @map("product_sku")
  productName   String @map("product_name")

  transaction   Transaction @relation(fields: [transactionId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@map("transaction_items")
}

model TransactionWorkflow {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @unique @db.Uuid @map("transaction_id")

  // Identificadores nativos do Temporal.io
  workflowId    String         @unique @map("workflow_id")
  runId         String         @map("run_id")
  taskQueue     String         @map("task_queue")

  status        WorkflowStatus @default(RUNNING)

  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  lastError     String?   @map("last_error")

  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([workflowId])
  @@index([status])
  @@map("transaction_workflows")
}

model CompensationLog {
  id            String  @id @default(uuid()) @db.Uuid
  transactionId String  @db.Uuid @map("transaction_id")

  // Nome do step do workflow que foi compensado
  step          String

  // Motivo da compensação
  reason        String

  // Dados usados na compensação (para debugging e replay)
  payload       Json?

  succeededAt   DateTime? @map("succeeded_at")
  failedAt      DateTime? @map("failed_at")
  error         String?

  // Append-only
  createdAt     DateTime  @default(now()) @map("created_at")

  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("compensation_logs")
}

// ============================================================
// AUDIT CONTEXT
// REGRA ABSOLUTA: nunca fazer UPDATE ou DELETE nessa tabela.
// Apenas INSERT. Imutável por convenção e por constraint de infra.
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  // Quem
  userId    String? @db.Uuid @map("user_id")
  userEmail String? @map("user_email") // snapshot — sobrevive à deleção do user

  // O que
  action     AuditAction
  resource   String  // "inventory.product" | "transaction" | "identity.user"
  resourceId String? @map("resource_id")

  // Como — diff completo da mutação
  before Json? // estado anterior  (null em CREATEs)
  after  Json? // estado posterior (null em DELETEs)
  diff   Json? // apenas os campos que mudaram (calculado na app layer)

  // Contexto técnico para correlação e debugging
  correlationId String? @map("correlation_id") // agrupa operações de uma mesma request
  traceId       String? @map("trace_id")       // OpenTelemetry trace ID
  ipAddress     String? @map("ip_address")
  userAgent     String? @map("user_agent")

  // Imutável — sem updatedAt por design
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  // Índices para os padrões de query mais comuns em dashboards de auditoria
  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

