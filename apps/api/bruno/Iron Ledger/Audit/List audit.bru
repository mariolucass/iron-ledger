meta {
  name: List audit
  type: http
  seq: 1
}

get {
  url: {{baseurl}}/audit?page=1&pageSize=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 20
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Consulta o log de auditoria. Filtros opcionais: eventName, entityType, entityId, actor, from e to (datas ISO). Se ambos forem informados, from deve ser anterior ou igual a to. page começa em 1; pageSize aceita de 1 a 100.
}
