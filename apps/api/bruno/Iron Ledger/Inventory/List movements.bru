meta {
  name: List movements
  type: http
  seq: 3
}

get {
  url: {{baseurl}}/inventory/{{stockLevelId}}/movements?page=1&pageSize=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  pageSize: 20
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  Substitua stockLevelId pelo UUID de um saldo existente. page começa em 1; pageSize aceita de 1 a 100.
}
