{
  "name": "@iron-ledger/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do iron-ledger: monólito modular (DDD) com outbox transacional e orquestração via Temporal.",
  "license": "MIT",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node ../../scripts/run-prisma.mjs generate",
    "prisma:validate": "node ../../scripts/run-prisma.mjs validate",
    "prisma:migrate": "node ../../scripts/run-prisma.mjs migrate dev",
    "prisma:deploy": "node ../../scripts/run-prisma.mjs migrate deploy",
    "prisma:seed": "node ../../scripts/run-prisma.mjs db seed",
    "prisma:studio": "node ../../scripts/run-prisma.mjs studio",
    "prisma:reset": "node ../../scripts/run-prisma.mjs migrate reset",
    "prisma:status": "node ../../scripts/run-prisma.mjs migrate status"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@iron-ledger/event-bus": "workspace:*",
    "@iron-ledger/logger": "workspace:*",
    "@iron-ledger/shared-types": "workspace:*",
    "@iron-ledger/workflow-contracts": "workspace:*",
    "@prisma/client": "~5.22.0",
    "@temporalio/client": "catalog:",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "catalog:",
    "prisma": "~5.22.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^2.1.9"
  }
}
