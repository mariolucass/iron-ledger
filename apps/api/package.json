{
  "name": "@iron-ledger/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do iron-ledger: monólito modular (DDD) com outbox transacional e orquestração via Temporal.",
  "license": "MIT",
  "main": "./dist/start.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/start.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node ../../scripts/db/run-prisma.mjs generate",
    "prisma:validate": "node ../../scripts/db/run-prisma.mjs validate",
    "prisma:migrate": "node ../../scripts/db/run-prisma.mjs migrate dev",
    "prisma:deploy": "node ../../scripts/db/run-prisma.mjs migrate deploy",
    "prisma:seed": "node ../../scripts/db/run-prisma.mjs db seed",
    "prisma:studio": "node ../../scripts/db/run-prisma.mjs studio",
    "prisma:reset": "node ../../scripts/db/run-prisma.mjs migrate reset",
    "prisma:status": "node ../../scripts/db/run-prisma.mjs migrate status"
  },
  "dependencies": {
    "@iron-ledger/event-bus": "workspace:*",
    "@iron-ledger/logger": "workspace:*",
    "@iron-ledger/shared-types": "workspace:*",
    "@iron-ledger/workflow-contracts": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "@temporalio/client": "catalog:",
    "@temporalio/interceptors-opentelemetry": "catalog:",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "prisma": "~7.10.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
