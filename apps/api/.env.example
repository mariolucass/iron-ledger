# ==============================================================================
# Iron Ledger - Exemplo de variáveis de ambiente
# Copie para .env (cp .env.example .env) e ajuste os valores.
# NUNCA commite o .env real. Apenas este arquivo de exemplo.
# ==============================================================================

# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------
# Valores: development | test | production
NODE_ENV=development
PORT=3000
# Valores: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=SCHEMA
# Se a senha tiver caracteres especiais (@ : / # ?), use URL-encode.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@localhost:5432/iron_ledger?schema=public

# ------------------------------------------------------------------------------
# Mensageria (RabbitMQ)
# Formato: amqp://USUARIO:SENHA@HOST:PORTA[/VHOST]
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@localhost:5672

# ------------------------------------------------------------------------------
# Autenticação (JWT)
# Gere um segredo forte (mín. 32 caracteres) com:
#   openssl rand -base64 48
# Use um segredo DIFERENTE em cada ambiente.
# ------------------------------------------------------------------------------
JWT_SECRET=<GENERATE_A_RANDOM_SECRET_MIN_32_CHARS>
# Formatos aceitos: 15m, 1h, 7d ...
JWT_EXPIRES_IN=1h
# Custo do bcrypt/argon2 (10-12 é um bom ponto de partida)
PASSWORD_HASH_ROUNDS=12

# ------------------------------------------------------------------------------
# Seed (usuário admin inicial, apenas para desenvolvimento)
# Troque a senha imediatamente fora do ambiente local.
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ironledger.local
SEED_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
