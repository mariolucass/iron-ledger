{
  "name": "@iron-ledger/temporal-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker Temporal do iron-ledger: Sagas de transação com activities que chamam a API.",
  "license": "MIT",
  "main": "./dist/start.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/start.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:temporal": "tsx --test \"src/**/*.it.ts\" \"tests/**/*.it.ts\""
  },
  "dependencies": {
    "@iron-ledger/logger": "workspace:*",
    "@iron-ledger/workflow-contracts": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@temporalio/activity": "catalog:",
    "@temporalio/interceptors-opentelemetry": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:"
  },
  "devDependencies": {
    "@temporalio/testing": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
