meta {
  name: Get point
  type: http
  seq: 2
}

get {
  url: {{baseurl}}/analytics/inflection-points/{{pointId}}
  body: none
  auth: none
}

docs {
  Consulta um ponto de inflexão pelo id retornado na listagem. Inclui rótulos legíveis, UF do vendedor (seller_state) e series, a série semanal da métrica em torno do ponto. Retorna 404 quando não existe.
}
